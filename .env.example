# ============================================================
# dsh-cost-cloud 环境变量示例
#   cp .env.example .env  然后逐项填写
# 缺 SESSION_SECRET 或 ADMIN_PASSWORD_HASH 时服务会**拒绝启动**（fail-closed）。
# ============================================================

# ---------- 必填 ----------
# 会话签名密钥（≥32 字节随机）。生成：
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 管理员口令哈希（scrypt）。生成：
#   node scripts/hash-password.js "你的口令"
# 也可以用明文 ADMIN_PASSWORD 临时试跑（不推荐长期使用）。
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=

# ---------- 建议填写 ----------
# 共享引导令牌：设备端凭它自注册接入（DSH 插件「共享引导令牌」填这个值）。
# 留空时可在看板「设置」页点一下自动生成并写回本文件。
DSH_SYNC_TOKEN=

# 是否允许设备自注册（由共享引导令牌保护）。看板里也可随时开关。
ALLOW_DEVICE_SELF_REGISTER=0

# 设备令牌（含共享引导令牌）是否可读只读聚合接口 /api/v1/overview|matrix|devices。
# 采集端插件用它读取云端看板数据（「仅云端 / 本机+云端」视图）；写入与管理接口不受影响。
# 默认开启；设为 0 可关闭（插件会显示 403 DEVICE_READ_DISABLED）。
ALLOW_DEVICE_READ=1

# ---------- 监听与存储 ----------
# 本机直跑用 127.0.0.1；容器/docker compose 用 0.0.0.0（compose 里已设）
HOST=127.0.0.1
# 监听端口；PORT=0 = 让系统分配空闲端口（测试 / 临时实例用）
PORT=8787
# SQLite 与备份目录（容器内固定 /data，由命名卷持久化）
DATA_DIR=./data

# ---------- 反向代理 ----------
# 部署在 Caddy/Nginx 之后时设为 1，才会采信 X-Forwarded-For
TRUST_PROXY=0

# ---------- 限流与配额（可选） ----------
# 单设备每分钟上报次数上限
RATE_LIMIT_PER_MIN=120
# 单批明细上限 / 请求体上限
MAX_BATCH_RECORDS=2000
MAX_BODY_BYTES=4194304
# 登录会话有效期（小时）
ADMIN_SESSION_TTL_HOURS=720

# ---------- 峰谷口径（v1.4.2） ----------
# 法定节假日表：官方把「中国法定节假日」全天计入空闲时段（周一至周五不含节假日才算高峰）。
# 留空 = 用 pricing.js 内置的 CN_HOLIDAYS（2026 全年 33 天，随版本更新）。
# 设为 none/off = 停用（只按周末判定）。
# 也可写自定义列表（逗号/空白分隔，支持 2027/1/1 写法）：
#   DSH_PEAK_HOLIDAYS=2027-01-01 2027-02-05 2027-02-06
# ⚠️ 采集端插件与本服务必须同口径，否则本地金额与云端入库重算金额会不一致
#    （插件侧在「设置 → 插件 → 插件配置 → 花费统计 → 峰谷计价与提示」里配置）。
DSH_PEAK_HOLIDAYS=

# ---------- 仅本地试跑（切勿用于公网） ----------
# 设为 1 时允许缺密钥启动，口令回退为 "admin"，会话密钥每次重启随机
ALLOW_INSECURE_DEV=0
